{
  "sandbox": {
    "excludedCommands": ["git push *", "git fetch *", "git pull *", "git ls-remote *", "gh *"],
    "network": {
      "allowedDomains": [
        "github.com", "*.github.com", "*.githubusercontent.com",
        "crates.io", "index.crates.io", "static.crates.io", "static.rust-lang.org"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path // empty'); case \"$FILE\" in *.rs) rustfmt \"$FILE\" 2>/dev/null ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/check-docs-updated.sh" }
        ]
      }
    ]
  }
}
